# Application
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (matches compose.yaml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metin2_warehouse
DB_USER=postgres
DB_PASSWORD=postgres

# Metin2Alerts synchronization
EXTERNAL_SYNC_ENABLED=false
EXTERNAL_SERVER_IDS=502,71
EXTERNAL_MARKET_URL_TEMPLATE=
EXTERNAL_SYNC_LOAD_MODE=delta
EXTERNAL_STATIC_SYNC_ENABLED=false
EXTERNAL_STATIC_BASE_URL=
EXTERNAL_SYNC_MIN_MINUTES=10
EXTERNAL_SYNC_MAX_MINUTES=15
EXTERNAL_TIMEOUT_SECONDS=30
EXTERNAL_STATIC_OUTPUT_DIR=./data/external
EXTERNAL_STATIC_STATE_FILE=./sync_static_state.json
EXTERNAL_MARKET_STATE_FILE=./sync_state.json

# Price normalization
WON_TO_YANG=100000000
WON_TO_YANG_OLD=1000000000

# ETL and logging
ETL_BATCH_SIZE=1000
ETL_MAX_WORKERS=4
ETL_TIMEOUT_SECONDS=3600
LOG_LEVEL=INFO
